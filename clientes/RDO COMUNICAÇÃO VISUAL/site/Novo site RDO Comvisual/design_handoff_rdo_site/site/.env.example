# E-mail que receberá os pedidos de orçamento
CONTACT_EMAIL=contato@rdocomvisual.com.br

# Configuração SMTP para envio de e-mails
# Exemplo: Gmail (smtp.gmail.com), SendGrid, ou seu próprio servidor
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM=noreply@rdocomvisual.com.br
